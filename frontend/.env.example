# Copy to .env.local. Defaults shown.
# true  = in-browser mock engine (offline demo, no backend needed)
# false = real FastAPI backend at VITE_API_URL
#
# For the real backend, start it first:
#   cd backend; python scripts/init_env.py; docker compose up --build -d
# Then wait for GET /health to report signatures_ready=true (first build runs
# hundreds of WNTR simulations).
VITE_USE_MOCKS=true
VITE_API_URL=http://localhost:8000
# Mock-only knobs
VITE_MOCK_LATENCY_MS=450
VITE_MOCK_SIGNATURES_MS=0
# Demo presets verified on the backend you present with (defaults are mock-verified)
# VITE_DEMO_SEEDS=[{"id":"A","label":"Demo A","story":"...","seed":897,"size":"medium","noise":"mid","k":6}]
