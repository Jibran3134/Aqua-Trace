ENVIRONMENT=development
POSTGRES_USER=aquatrace
POSTGRES_DB=aquatrace
POSTGRES_PASSWORD=replace-with-a-random-url-safe-password
POSTGRES_PORT=5432
REDIS_PASSWORD=replace-with-a-different-random-url-safe-password
REDIS_PORT=6379
DATABASE_URL=postgresql+psycopg://aquatrace:replace-with-a-random-url-safe-password@localhost:5432/aquatrace
MIGRATION_DATABASE_URL=postgresql+psycopg://aquatrace:replace-with-a-random-url-safe-password@localhost:5432/aquatrace
REDIS_URL=redis://:replace-with-a-different-random-url-safe-password@localhost:6379/0
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
API_BIND_HOST=127.0.0.1
API_PORT=8000
SIGNATURE_AUTO_BUILD=true
CENTER_RESIDUALS=false
DETECTOR_TAU=0.05
DEFAULT_SENSORS_K=6
SIMULATION_CONCURRENCY=2
SENSOR_DROPOUT_RATE=0.0
SCENARIO_TTL_HOURS=24
SCENARIO_MAX_COUNT=200
CACHE_TTL_S=300
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CAPACITY=60
RATE_LIMIT_REFILL_PER_S=1.0
EXPENSIVE_RATE_LIMIT_CAPACITY=10
EXPENSIVE_RATE_LIMIT_REFILL_PER_S=0.1
RATE_LIMIT_FAIL_CLOSED=true
MAX_REQUEST_BYTES=65536
LLM_ENABLED=true
DEMO_MODE=false
LLM_1_BASE_URL=https://api.groq.com/openai/v1
LLM_1_API_KEY=
LLM_1_MODEL=openai/gpt-oss-120b
LLM_2_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_2_API_KEY=
LLM_2_MODEL=gemini-3.8-flash
GROK_API_KEY=
GROK_MODEL=grok-2-latest
LLM_TIMEOUT_S=8
MAX_AGENT_STEPS=6
LOG_LEVEL=INFO
DEMAND_PROJECTION=true
SENSOR_DISTANCE_METRIC=hops
